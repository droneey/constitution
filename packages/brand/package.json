{
  "name": "@droneey/constitution-brand",
  "version": "0.0.0",
  "private": true,
  "description": "The Constitution's own accent, the brand tokens its program and its site are drawn with.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "packages/brand"
  },
  "type": "module",
  "exports": {
    ".": "./brand.tokens.json"
  },
  "scripts": {
    "check": "bun run --sequential 'check:*'",
    "check:format": "biome format",
    "check:lint": "ast-grep scan && biome check --formatter-enabled=false --error-on-warnings",
    "fix": "bun run --sequential 'fix:*'",
    "fix:format": "biome format --write",
    "fix:lint": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3"
  },
  "trustedDependencies": []
}
