  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "packages/mutation-check/languages/typescript"
  },
  "type": "module",
  "bin": {
    "mutation-check": "./src/main.ts"
  },
  "exports": {
