{
  "name": "@droneey/mutation-check",
  "version": "0.0.0",
  "private": true,
  "description": "Mutates only the lines a change touches, over Stryker.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "packages/mutation-check/languages/typescript"
  },
  "type": "module",
  "bin": {
    "mutation-check": "./src/main.ts"
  },
  "exports": {
    "./runner": "./src/integrations/stryker/runner.ts",
    "./ignorers": "./src/integrations/stryker/ignorers.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "lint:check": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "type:check": "tsc -b",
    "test:unit": "CI=1 bun test",
    "test:integration": "CI=1 bun --config=./bunfig.integration.toml test",
    "test:e2e": "CI=1 bun --config=./bunfig.e2e.toml test",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "mutation:check": "bun --no-env-file src/main.ts",
    "mutation:all": "bun --no-env-file src/main.ts all",
    "architecture:check": "depcruise src --config .dependency-cruiser.mjs",
    "unused:check": "knip --no-config-hints && knip --strict --no-config-hints",
    "yaml:check": "yamllint --strict ."
  },
  "dependencies": {
    "@stryker-mutator/api": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@stryker-mutator/core": "10.0.0",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.6.0",
    "knip": "6.41.0",
    "typescript": "7.0.2"
  }
}
