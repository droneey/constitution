{
  "ignoreBinaries": [
    "tombi",
    "yamllint",
    "stryker",
  ],
  "entry": [
    "src/main.{ts,tsx}!",
    "scripts/*/main.ts",
    "src/entrypoints/*/main.{ts,tsx}!",
    "src/**/index.{ts,tsx}!",
    "src/integrations/stryker/runner.ts!",
    "src/integrations/stryker/ignorers.ts!",
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/__tests__/**!",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts",
  ],
  "ignoreDependencies": [
    "@stryker-mutator/bun-specs-runner",
  ],
}
