# machine local files ignored
.claude/settings.local.json
.claude/worktrees/

# working notes stay out of history
/local/

# gitignore covers dependencies output and caches
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.log
**/logs/
.temp/
.tmp/
*.bak
*.orig
*~

# gitignore covers environment files
.env*
!.env.example

# gitignore covers key files
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
id_rsa
*.secrets

# complexipy
.complexipy_cache/

# mutmut
mutants/

# pytest
.pytest_cache/
.coverage
htmlcov/

# python
__pycache__/
*.py[cod]
*.egg-info/

# ruff
.ruff_cache/

# uv
.venv/
**/dist/
