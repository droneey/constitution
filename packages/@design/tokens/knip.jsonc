{
  // stryker
  "ignoreDependencies": [
    "@stryker-mutator/bun-specs-runner",
    "@stryker-mutator/core",
  ],

  // knip
  "entry": [
    "src/entrypoints/*/main.{ts,tsx}!",
    "src/**/index.{ts,tsx}!",
    "src/main.{ts,tsx}!",
    "scripts/*/main.ts",
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/__tests__/**!",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts",
  ],
  "ignoreBinaries": [
    // rumdl
    "rumdl",

    // tombi
    "tombi",

    // yamllint
    "yamllint",
  ],
}
