{
  "name": "@droneey/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "The tokens every droneey interface is drawn with, in the W3C Design Tokens format, the resolver of their modes, and the runner that builds each platform's theme from them.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "packages/@design/tokens"
  },
  "type": "module",
  "bin": {
    "design-tokens": "./src/entrypoints/design-generate/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens/*": "./tokens/*"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "check": "bun run --sequential 'check:*' test mutate:branch",
    "check:architecture": "depcruise src tests --config .dependency-cruiser.jsonc",
    "check:duplicates": "jscpd",
    "check:format": "biome format && rumdl fmt --check . && tombi format --check",
    "check:lint": "ast-grep scan && biome check --formatter-enabled=false --error-on-warnings && rumdl check . && tombi lint && .droneey/constitution/presets/plugins/shell/run-on-files.sh '*.yaml' '*.yml' -- yamllint --strict --",
    "check:types": "tsc -b",
    "check:unused": "knip --no-config-hints && knip --strict --no-config-hints",
    "fix": "bun run --sequential 'fix:*'",
    "fix:format": "biome format --write && rumdl fmt . && tombi format",
    "fix:lint": "biome check --write && rumdl check --fix .",
    "mutate:all": "mutation-check all",
    "mutate:branch": "mutation-check",
    "test": "bun run --parallel 'test:*'",
    "test:integration": "CI=1 bun --config=./bunfig.integration.toml test",
    "test:proofs": "CI=1 bun --config=./bunfig.proofs.toml test",
    "test:unit": "CI=1 bun test"
  },
  "dependencies": {
    "style-dictionary": "^5.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@droneey/mutation-check-typescript": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "1.4.4",
    "colorjs.io": "0.7.1",
    "dependency-cruiser": "18.7.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "typescript": "7.0.2"
  },
  "trustedDependencies": []
}
