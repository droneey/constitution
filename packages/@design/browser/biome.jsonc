    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noIdenticalTestTitle": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.jsonc",
      ],
      "json": {
        "formatter": {
          "trailingCommas": "all",
        },
      },
    },

    // bun-test
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "domains": {
          "test": "all",
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveNestedTestSuites": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTestIt": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "style": {
            "useTestHooksInOrder": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "style": {
            "useTestHooksOnTop": "error",
          },
        },
      },
    },

    // dependency-cruiser
    {
      "includes": [
        "**/.dependency-cruiser.js",
        "**/.dependency-cruiser.mjs",
        "**/.dependency-cruiser.cjs",
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/.dependency-cruiser.js",
        "**/.dependency-cruiser.mjs",
        "**/.dependency-cruiser.cjs",
      ],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off",
          },
        },
      },
    },
  ],
  "assist": {
    "actions": {
      "source": {
        // typescript
        "useSortedInterfaceMembers": {
          "level": "on",
          "options": {},
        },
        "organizeImports": {
          "options": {
            // biome
            "identifierOrder": "natural",
            "groups": [
              // biome
              ":URL:",

              // _react
              ":BLANK_LINE:",

              // biome
              ":NODE:",

              // _react
              ":BLANK_LINE:",

              // biome
              ":BUN:",

              // _react
              ":BLANK_LINE:",
              [
                "react",
                "react/**",
                "react-*",
              ],
              ":BLANK_LINE:",

              // biome
              ":PACKAGE:",

              // _react
              ":BLANK_LINE:",

              // biome
              ":ALIAS:",

              // _react
              ":BLANK_LINE:",

              // biome
              ":PATH:",
            ],
          },

          // biome
          "level": "on",
        },
      },
    },
  },

  // biome
  "markdown": {
    "linter": {
      "enabled": false,
    },
    "formatter": {
      "enabled": false,
    },
  },
  "css": {
    // biome
    "formatter": {
      "quoteStyle": "single",
    },

    // tailwind
    "parser": {
      "tailwindDirectives": true,
    },
  },

  // biome
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "attributePosition": "multiline",
    },
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single",
    },
  },

  // git
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
  },
}
