{
  "name": "@droneey/design-browser",
  "version": "0.0.0",
  "private": true,
  "description": "The design system of every droneey site: its theme as CSS variables and base styles, its Tailwind theme, and its components, icons and motion on React DOM.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "packages/@design/browser"
  },
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./tailwind.css": "./src/integrations/tailwind/tailwind.css",
    "./react-dom": "./src/integrations/react-dom/index.ts",
    "./react-dom/styles.css": "./src/integrations/react-dom/styles.css"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "check": "bun run --sequential 'check:*' test mutate:branch",
    "check:architecture": "depcruise src scripts --config .dependency-cruiser.jsonc",
    "check:duplicates": "jscpd",
    "check:lint": "biome check --error-on-warnings",
    "check:markdown": "rumdl check . && rumdl fmt --check .",
    "check:toml": "tombi format --check && tombi lint",
    "check:types": "tsc -b",
    "check:unused": "knip --no-config-hints && knip --strict --no-config-hints",
    "check:yaml": "yamllint --strict .",
    "fix": "bun run --sequential 'fix:*'",
    "fix:lint": "biome check --write",
    "fix:markdown": "rumdl check --fix",
    "fix:toml": "tombi format",
    "generate": "design-tokens generate style-dictionary.config.ts",
    "mutate:all": "mutation-check all",
    "mutate:branch": "mutation-check",
    "test": "bun run --parallel 'test:*'",
    "test:integration": "CI=1 bun --config=./bunfig.integration.toml test",
    "test:unit": "CI=1 bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "lucide-react": "^1.57.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@droneey/design-tokens": "workspace:*",
    "@droneey/mutation-check-typescript": "workspace:*",
    "@happy-dom/global-registrator": "21.0.4",
    "@stryker-mutator/core": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.7.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "style-dictionary": "5.7.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "trustedDependencies": []
}
