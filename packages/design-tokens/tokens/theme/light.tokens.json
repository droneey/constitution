{
  "color": {
    "$type": "color",
    "$description": "The roles the interface reads in the light mode, each a step of a scale; the other mode's file names the same roles.",
    "surface": {
      "canvas": {
        "$value": "{color.neutral.50}"
      },
      "base": {
        "$value": "{color.neutral.25}"
      },
      "level-1": {
        "$value": "{color.neutral.50}"
      },
      "level-2": {
        "$value": "{color.neutral.100}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.900}"
      },
      "muted": {
        "$value": "{color.neutral.600}"
      },
      "danger": {
        "$value": "{color.red.600}"
      },
      "success": {
        "$value": "{color.green.600}"
      },
      "warning": {
        "$value": "{color.orange.600}"
      },
      "info": {
        "$value": "{color.blue.600}"
      }
    },
    "border": {
      "base": {
        "$value": "{color.neutral.200}"
      },
      "strong": {
        "$value": "{color.neutral.300}"
      },
      "danger": {
        "$value": "{color.overlay.red-600-35}"
      },
      "success": {
        "$value": "{color.overlay.green-600-35}"
      }
    },
    "fill": {
      "muted": {
        "$value": "{color.neutral.100}"
      },
      "field": {
        "$value": "{color.neutral.0}"
      },
      "field-hover": {
        "$value": "{color.neutral.25}"
      },
      "hover": {
        "$value": "{color.overlay.neutral-900-6}"
      },
      "danger": {
        "$value": "{color.overlay.red-600-8}"
      },
      "success": {
        "$value": "{color.overlay.green-600-8}"
      }
    },
    "selection": {
      "base": {
        "$value": "{color.brand.200}"
      }
    },
    "ring": {
      "focus": {
        "$value": "{color.brand.600}"
      }
    },
    "accent": {
      "solid": {
        "$value": "{color.brand.600}"
      },
      "hover": {
        "$value": "{color.brand.700}"
      },
      "pressed": {
        "$value": "{color.brand.800}"
      },
      "subtle": {
        "$value": "{color.brand.50}"
      },
      "text": {
        "$value": "{color.brand.600}"
      },
      "end": {
        "$value": "{color.brand.700}"
      },
      "muted": {
        "$value": "{color.brand.50}"
      },
      "on-solid": {
        "$value": "{color.neutral.0}"
      }
    }
  },
  "font": {
    "weight": {
      "$type": "fontWeight",
      "normal": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "ui": {
        "$value": 450,
        "$description": "Interface text: a touch heavier than body text."
      }
    }
  },
  "stroke": {
    "$type": "number",
    "$description": "The stroke of icons, lighter in the dark mode, where light marks spread.",
    "icon": {
      "$value": 2.25
    }
  }
