{
  "name": "@droneey/mutation-check-typescript",
  "version": "0.0.0",
  "private": true,
  "description": "Mutates only the lines a change touches, over Stryker.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "packages/@mutation-check/typescript"
  },
  "type": "module",
  "bin": {
    "mutation-check": "./src/main.ts"
  },
  "exports": {
    "./runner": "./src/integrations/stryker/index.ts",
    "./ignorers": "./src/integrations/stryker/ignorers.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "bun build --target=bun --packages=external src/main.ts --outfile dist/main.js && bun build --target=bun src/integrations/stryker/index.ts --outfile dist/runner.js && bun build --target=bun src/integrations/stryker/ignorers.ts --outfile dist/ignorers.js",
    "check": "bun run --sequential 'check:*' test mutate:branch",
    "check:architecture": "depcruise src tests --config .dependency-cruiser.jsonc",
    "check:duplicates": "jscpd",
    "check:lint": "biome check --error-on-warnings",
    "check:toml": "tombi format --check && tombi lint",
    "check:types": "tsc -b",
    "check:unused": "knip --no-config-hints && knip --strict --no-config-hints",
    "check:yaml": "yamllint --strict .",
    "fix": "bun run --sequential 'fix:*'",
    "fix:lint": "biome check --write",
    "fix:toml": "tombi format",
    "mutate:all": "bun --no-env-file src/main.ts all",
    "mutate:branch": "bun --no-env-file src/main.ts",
    "test": "bun run --parallel 'test:*'",
    "test:e2e": "CI=1 bun --config=./bunfig.e2e.toml test",
    "test:integration": "CI=1 bun --config=./bunfig.integration.toml test",
    "test:unit": "CI=1 bun test"
  },
  "dependencies": {
    "@stryker-mutator/api": "^10.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.7.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "typescript": "7.0.2"
  },
  "trustedDependencies": []
}
