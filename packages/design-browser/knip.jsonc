{
  "entry": [
    "src/main.{ts,tsx}!",
    "scripts/*/main.ts",
    "src/entrypoints/*/main.{ts,tsx}!",
    "src/**/index.{ts,tsx}!",
    "style-dictionary.config.ts",
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/__tests__/**!",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts",
  ],
  "ignoreDependencies": [
    "@stryker-mutator/bun-specs-runner",
    "@stryker-mutator/core",
    "react",
    "react-dom",
    "tailwindcss",
  ],
  "ignoreBinaries": [
    "rumdl",
    "tombi",
    "yamllint",
  ],
}
