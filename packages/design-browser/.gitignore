# The theme the build generates
/src/libs/ui/theme/*.gen.*

# machine local files ignored
.claude/settings.local.json
.claude/worktrees/

# working notes stay out of history
/local/

# gitignore covers dependencies output and caches
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.log
**/logs/
.temp/
.tmp/
*.bak
*.orig
*~

# gitignore covers environment files
.env*
!.env.example

# gitignore covers key files
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
id_rsa
*.secrets

# _js-runtime
**/node_modules/
*.tgz

# bun-test
**/coverage/

# bun
.npmrc

# rumdl
.rumdl_cache/

# stryker
.stryker-tmp/
reports/mutation/

# tsc
*.tsbuildinfo

# tsc with workspace
.tsc-cache/
