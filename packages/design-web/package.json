{
  "name": "@droneey/design-web",
  "version": "0.0.0",
  "private": true,
  "description": "The design system of every droneey site: its theme as CSS variables and base styles, its Tailwind theme, and its components, icons and motion on React DOM.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "packages/design-web"
  },
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./tailwind.css": "./src/integrations/tailwind/tailwind.css",
    "./react-dom": "./src/integrations/react-dom/index.ts",
    "./react-dom/styles.css": "./src/integrations/react-dom/styles.css"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "design:build": "bun src/entrypoints/design-build/main.ts",
    "design:check": "bun src/entrypoints/design-build/main.ts check",
    "test": "CI=1 bun test",
    "mutation:check": "mutation-check",
    "mutation:all": "mutation-check all",
    "architecture:check": "depcruise src --config .dependency-cruiser.mjs",
    "unused:check": "knip --no-config-hints && knip --strict --no-config-hints"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "lucide-react": "^1.57.0"
  },
  "devDependencies": {
    "@droneey/design-tokens": "workspace:*",
    "@droneey/mutation-check": "workspace:*",
    "@happy-dom/global-registrator": "21.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.6.0",
    "knip": "6.41.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "style-dictionary": "5.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  }
}
