{
  "name": "@droneey/design-cli",
  "version": "0.0.0",
  "private": true,
  "description": "The design system of every droneey command line: its theme, glyphs and plain formatters, and its components and prompts on Ink.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "packages/design-cli"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ink": "./src/integrations/ink/index.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "design-tokens build style-dictionary.config.ts",
    "lint:check": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "pretype:check": "bun run build",
    "type:check": "tsc -b",
    "pretest": "bun run build",
    "test": "CI=1 bun test",
    "premutation:check": "bun run build",
    "mutation:check": "mutation-check",
    "premutation:all": "bun run build",
    "mutation:all": "mutation-check all",
    "prearchitecture:check": "bun run build",
    "architecture:check": "depcruise src --config .dependency-cruiser.mjs",
    "preunused:check": "bun run build",
    "unused:check": "knip --no-config-hints && knip --strict --no-config-hints",
    "markdown:check": "rumdl check . && rumdl fmt --check .",
    "markdown:fix": "rumdl check --fix",
    "yaml:check": "yamllint --strict .",
    "toml:check": "tombi format --check && tombi lint",
    "toml:fix": "tombi format"
  },
  "dependencies": {
    "ansis": "^4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@droneey/design-tokens": "workspace:*",
    "@droneey/mutation-check": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "ink": "8.0.0",
    "ink-testing-library": "4.0.0",
    "knip": "6.41.0",
    "react": "19.3.1",
    "style-dictionary": "5.7.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "ink": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
