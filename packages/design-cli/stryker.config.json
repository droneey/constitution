{
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/__tests__/**",
    "!src/main.{ts,tsx}",
    "!src/**/*.gen.*",
    "!src/**/*.d.ts",
    "scripts/**/*.ts",
    "!scripts/**/__tests__/**",
    "!scripts/*/main.ts",
    "!src/entrypoints/*/main.{ts,tsx}",
    "!src/root/wiring.{ts,tsx}"
  ],
  "thresholds": {
    "break": 100,
    "high": 100,
    "low": 100
  },
  "ignorePatterns": [
    "/.droneey",
    "*/worktrees"
  ],
  "plugins": [
    "../mutation-check/languages/typescript/src/integrations/stryker/runner.ts",
    "../mutation-check/languages/typescript/src/integrations/stryker/ignorers.ts"
  ],
  "ignorers": [
    "diagnostics"
  ],
  "reporters": [
    "clear-text"
  ],
  "clearTextReporter": {
    "allowColor": false,
    "logTests": false
  },
  "tempDirName": ".stryker-tmp",
  "tsconfigFile": "stryker-has-no-tsconfig.json",
  "timeoutMS": 30000,
  "concurrency": "50%",
  "testRunner": "bun-specs",
  "coverageAnalysis": "off",
  "diagnosticsTextArguments": {
    "new *Error": 0
  }
}
