{
  // knip
  "entry": [
    "src/main.{ts,tsx}!",
    "scripts/*/main.ts",
    "src/entrypoints/*/main.{ts,tsx}!",
    "src/**/index.{ts,tsx}!",
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/__tests__/**!",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts",
  ],
  "ignoreBinaries": [
    // rumdl
    "rumdl",

    // shellcheck
    "shellcheck",

    // shfmt
    "shfmt",

    // tombi
    "tombi",

    // yamllint
    "yamllint",
    "mkfifo",
    "lefthook",
    "mise",
  ],

  // stryker
  "ignoreDependencies": [
    "@stryker-mutator/bun-specs-runner",
    "@biomejs/biome",
    "@stryker-mutator/core",
    "@swc/core",
    "dclint",
    "syncpack",
  ],
}
