{
  "name": "@droneey/constitution",
  "version": "0.88.0",
  "private": true,
  "description": "The Droneey Constitution: the engineering rules a project declares in constitution.yaml, by blocks.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "packages/constitution"
  },
  "type": "module",
  "bin": {
    "constitution": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./blocks/*": "./blocks/*",
    "./package.json": "./package.json"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "bun scripts/cli-build/main.ts",
    "check": "bun run --sequential 'check:*' test mutate:branch",
    "check:architecture": "depcruise src scripts tests --config .dependency-cruiser.jsonc",
    "check:blocks": "bun run ./src/main.ts check",
    "check:duplicates": "jscpd",
    "check:lint": "biome check --error-on-warnings",
    "check:markdown": "rumdl check . && rumdl fmt --check .",
    "check:shell": "git ls-files -z --cached --others --exclude-standard -- '*.sh' '*.bash' | xargs -0 -r sh -c \"for file do if [ -e \\\"\\$file\\\" ]; then printf '%s\\0' \\\"\\$file\\\"; fi; done\" sh | xargs -0 -r shellcheck",
    "check:shell-format": "git ls-files -z --cached --others --exclude-standard -- '*.sh' '*.bash' | xargs -0 -r sh -c \"for file do if [ -e \\\"\\$file\\\" ]; then printf '%s\\0' \\\"\\$file\\\"; fi; done\" sh | xargs -0 -r shfmt -d",
    "check:toml": "tombi format --check && tombi lint",
    "check:types": "tsc -b",
    "check:unused": "knip --no-config-hints && knip --strict --no-config-hints",
    "check:yaml": "yamllint --strict .",
    "executable:test": "CI=1 bun --config=./bunfig.e2e.toml test --parallel --timeout=30000 tests/e2e/hooks tests/e2e/cli.e2e.test.ts",
    "fix": "bun run --sequential 'fix:*'",
    "fix:lint": "biome check --write",
    "fix:markdown": "rumdl check --fix",
    "fix:shell-format": "git ls-files -z --cached --others --exclude-standard -- '*.sh' '*.bash' | xargs -0 -r sh -c \"for file do if [ -e \\\"\\$file\\\" ]; then printf '%s\\0' \\\"\\$file\\\"; fi; done\" sh | xargs -0 -r shfmt -w",
    "fix:toml": "tombi format",
    "mutate:all": "mutation-check all",
    "mutate:branch": "mutation-check",
    "prebuild": "bun run --filter '@droneey/constitution^...' generate",
    "precheck": "bun run --filter '@droneey/constitution^...' generate",
    "preexecutable:test": "bun run --filter '@droneey/constitution^...' generate",
    "premutate:all": "bun run --filter '@droneey/constitution^...' generate",
    "pretest": "bun run --filter '@droneey/constitution^...' generate",
    "test": "bun run --parallel 'test:*'",
    "test:e2e": "CI=1 bun --config=./bunfig.e2e.toml test --parallel --timeout=30000",
    "test:integration": "CI=1 bun --config=./bunfig.integration.toml test",
    "test:unit": "CI=1 bun test"
  },
  "dependencies": {
    "@droneey/constitution-brand": "workspace:*",
    "@droneey/design-cli": "workspace:*",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@biomejs/biome": "2.6.3",
    "@droneey/mutation-check-typescript": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@swc/core": "1.16.20",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dclint": "3.1.0",
    "dependency-cruiser": "18.7.0",
    "fast-check": "4.10.2",
    "ink-testing-library": "4.0.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "syncpack": "15.3.3",
    "typescript": "7.0.2"
  },
  "constitutionFormat": 4,
  "trustedDependencies": []
}
