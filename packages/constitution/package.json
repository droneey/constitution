{
  "name": "@droneey/constitution",
  "version": "0.80.0",
  "private": true,
  "description": "The Droneey Constitution: the engineering rules a project declares in constitution.yaml, by blocks.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "packages/constitution"
  },
  "type": "module",
  "bin": {
    "constitution": "./src/main.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "lint:check": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "type:check": "tsc -b",
    "test:unit": "CI=1 bun test",
    "test:e2e": "CI=1 bun --config=./bunfig.e2e.toml test",
    "test:hooks": "CI=1 bun --config=./bunfig.e2e.toml test tests/e2e/hooks",
    "test": "bun run test:unit && bun run test:e2e",
    "blocks:check": "bun run ./src/main.ts check",
    "mutation:check": "mutation-check",
    "mutation:all": "mutation-check all",
    "architecture:check": "depcruise src tests --config .dependency-cruiser.mjs",
    "unused:check": "knip --no-config-hints && knip --strict --no-config-hints",
    "shell:check": "shellcheck hooks/*.sh && shfmt -d hooks",
    "markdown:check": "rumdl check . && rumdl fmt --check .",
    "markdown:fix": "rumdl check --fix",
    "yaml:check": "yamllint --strict ."
  },
  "dependencies": {
    "@droneey/design-cli": "workspace:*",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@biomejs/biome": "2.5.15",
    "@droneey/mutation-check": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@swc/core": "1.16.18",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dclint": "3.1.0",
    "dependency-cruiser": "18.6.0",
    "ink-testing-library": "4.0.0",
    "knip": "6.41.0",
    "syncpack": "15.3.3",
    "typescript": "7.0.2"
  },
  "constitutionFormat": 3
}
