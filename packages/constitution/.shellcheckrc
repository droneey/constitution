# shellcheck: the Constitution's parts, copied, each between its two lines, since shellcheck reads no other file
# from .droneey/constitution/presets/shell/shellcheck/foundation/self.shellcheckrc
enable=quote-safe-variables
enable=check-set-e-suppressed
enable=check-extra-masked-returns
# end .droneey/constitution/presets/shell/shellcheck/foundation/self.shellcheckrc
