{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": [
    "./.droneey/constitution/presets/common/biome/foundation/self.jsonc",
    "./.droneey/constitution/presets/typescript/biome/foundation/self.jsonc",
    "./.droneey/constitution/presets/typescript/biome/foundation/core.jsonc",
    "./.droneey/constitution/presets/typescript/biome/foundation/typescript.jsonc",
    "./.droneey/constitution/presets/typescript/biome/foundation/_react.jsonc",
    "./.droneey/constitution/presets/typescript/biome/foundation/bun-test.jsonc",
    "./.droneey/constitution/presets/typescript/biome/foundation/dependency-cruiser.jsonc",
    "./.droneey/constitution/presets/typescript/biome/foundation/zod.jsonc",
    "./.droneey/constitution/presets/typescript/biome/architecture/core.jsonc",
    "./.droneey/constitution/presets/typescript/biome/architecture/typescript.jsonc",
    "./.droneey/constitution/presets/typescript/biome/architecture/ui.jsonc"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "."
  },
  "files": {
    "includes": [
      "!!templates/project/**/biome.json"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**/__tests__/**",
        "tests/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
