language css

// Why: a media or container query measures the viewport rather than sizing a box by it.
CssRegularDimension() as $size where {
  $size <: r"(?i).*\d(?:l?vh)",
  $size <: not within or {
    CssQueryFeaturePlain(),
    CssQueryFeatureRange(),
    CssQueryFeatureReverseRange(),
    CssQueryFeatureRangeInterval()
  },
  register_diagnostic(span=$size, message="[viewport-height-leaves-out-the-browsers-toolbars] Use svh or dvh for a height: vh and lvh count the space under the toolbars", severity="error")
}
