language js

`$callee($...)` where {
  $callee <: r"(?:test|it|describe)(?:\.(?:concurrent|serial|each))*\.(?:todo|if|skipIf|todoIf|failing)(?:\.each)?",
  register_diagnostic(span=$callee, message="[test-never-skipped-or-empty] Write the case so it runs every time: no todo, conditional or expected-failure case", severity="error")
}
