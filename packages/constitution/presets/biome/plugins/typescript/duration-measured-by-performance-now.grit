language js

pattern wall_clock_reading() {
  or {
    `Date.now()`,
    `new Date().getTime()`,
    `Temporal.Now.$_($...)`
  }
}

pattern wall_clock_declarators($start) {
  JsVariableDeclaration(declarators=some JsVariableDeclarator(id=$start, initializer=JsInitializerClause(expression=wall_clock_reading())))
}

// A statement that gives a name a wall-clock reading, declared or assigned; the code inside it
// is not read, so a name of another function's is never taken for it.
pattern wall_clock_statement($start) {
  or {
    JsVariableStatement(declaration=wall_clock_declarators($start)),
    JsExport(export_clause=JsVariableDeclarationClause(declaration=wall_clock_declarators($start))),
    JsExpressionStatement(expression=JsAssignmentExpression(left=$start, right=wall_clock_reading()))
  }
}

// A name given a wall-clock reading where the difference can see it: by a statement of a function
// body, a block, a case or a static block around it, or of the module; or a field of its class,
// read through this and given the reading where it is declared or through this.
pattern wall_clock_start() {
  or {
    `this.$field` where {
      $field <: within or {
        JsClassDeclaration(),
        JsClassExpression()
      } as $class,
      $class <: contains or {
        JsPropertyClassMember(name=$field, value=JsInitializerClause(expression=wall_clock_reading())),
        JsAssignmentExpression(left=JsStaticMemberAssignment(object=JsThisExpression(), member=$field), right=wall_clock_reading())
      }
    },
    $start where {
      or {
        $start <: within JsFunctionBody(statements=some wall_clock_statement($start)),
        $start <: within JsBlockStatement(statements=some wall_clock_statement($start)),
        $start <: within JsCaseClause(consequent=some wall_clock_statement($start)),
        $start <: within JsDefaultClause(consequent=some wall_clock_statement($start)),
        $start <: within JsStaticInitializationBlockClassMember(statements=some wall_clock_statement($start)),
        $start <: within JsModule(items=some wall_clock_statement($start))
      }
    }
  }
}

or {
  `Date.now() - $start`,
  `new Date().getTime() - $start`,
  `Temporal.Now.$_($...).since($start)`,
  `Temporal.Now.$_($...).until($start)`,
  `$start.since(Temporal.Now.$_($...))`,
  `$start.until(Temporal.Now.$_($...))`
} as $difference where {
  $start <: wall_clock_start(),
  register_diagnostic(span=$difference, message="[duration-measured-by-performance-now] Measure a duration with performance.now(): the wall clock jumps", severity="error")
}
