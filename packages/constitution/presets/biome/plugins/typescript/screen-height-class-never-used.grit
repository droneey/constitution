language js

or {
  jsx_attribute(name=$name, value=$classes) where { $name <: r"className" },
  or {
    `cva($...)`,
    `cn($...)`,
    `clsx($...)`,
    `twMerge($...)`
  } as $classes where { $classes <: not within jsx_attribute() }
} where {
  $classes <: r"(?s).*\bh-screen\b.*",
  register_diagnostic(span=$classes, message="[screen-height-class-never-used] Size to the small viewport with h-svh, or to the container: h-screen ignores the phone's toolbars", severity="error")
}
