language js

// Biome keeps comments as trivia, out of reach of a node pattern, but inside the text of the
// callback, so the sections are read from that text: a section opens with a line that holds only
// its comment, and the next one found is the nearest, since `.*?` is lazy.
pattern next_section($name, $rest) { r"(?s).*?\n[ \t]*// (Arrange|Act|Assert)\n(.*)"($name, $rest) }

pattern after_act() {
  next_section($name, $rest) where { $name <: "Assert", $rest <: after_assert() }
}

// A lifecycle or an end-to-end case repeats an Act and its Assert for each step.
pattern after_assert() {
  or {
    not includes r"\n[ \t]*// (?:Arrange|Act|Assert)\n",
    next_section($name, $rest) where { $name <: "Act", $rest <: after_act() }
  }
}

// An Arrange the next section's comment follows at once is empty, and an empty one is refused.
pattern sections() {
  next_section($name, $rest) where {
    or {
      and {
        $name <: "Arrange",
        $rest <: not r"(?s)[ \t\n]*// (?:Arrange|Act|Assert)\n.*",
        $rest <: next_section($next, $tail) where { $next <: "Act", $tail <: after_act() }
      },
      and { $name <: "Act", $rest <: after_act() }
    }
  }
}

`$runner($title, $body, $...)` where {
  $runner <: or {
    `test`,
    `it`,
    `$_.concurrent`,
    `$_.each($_)`,
    `$_.concurrent.each($_)`
  },
  $body <: not sections(),
  register_diagnostic(span=$title, message="[case-split-by-arrange-act-assert-comments] Open the sections of a case with // Arrange where it sets anything up, then // Act and // Assert, each on a line of its own and in that order", severity="error"),
  // Biome keeps what a match adds to its matching state and copies that state
  // before every node, so each match would slow the next: the diagnostic stays,
  // the match fails.
  false
}
