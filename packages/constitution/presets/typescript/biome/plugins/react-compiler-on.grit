language js

or {
  `useMemo($...)`,
  `useCallback($...)`,
  `memo($...)`,
  `React.useMemo($...)`,
  `React.useCallback($...)`,
  `React.memo($...)`
} as $call where {
  register_diagnostic(span=$call, message="Leave memoisation to the React Compiler; an effect's callback is wrapped in useEffectEvent", severity="error")
}
