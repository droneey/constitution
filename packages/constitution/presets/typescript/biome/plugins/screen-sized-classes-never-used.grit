language js

or {
  jsx_attribute(name=$name, value=$classes) where { $name <: r"className" },
  or {
    `cva($...)`,
    `cn($...)`,
    `clsx($...)`,
    `twMerge($...)`
  } as $classes where { $classes <: not within jsx_attribute() }
} where {
  $classes <: r"(?s).*\b[hw]-screen\b.*",
  register_diagnostic(span=$classes, message="Size to the small viewport with h-svh, or to the container: h-screen and w-screen ignore the phone's toolbars and the scrollbar", severity="error")
}
