{
  "overrides": [
    {
      "includes": [
        "**/*.use-case.ts",
        "**/*.adapter.ts",
        "**/*.repository.ts",
        "**/*.sink.ts",
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.adapter.ts",
        "**/*.repository.ts",
        "**/*.sink.ts",
      ],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off",
          },
        },
      },
    },
  ],
}
