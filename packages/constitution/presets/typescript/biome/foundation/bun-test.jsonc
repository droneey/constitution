{
  "overrides": [
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "domains": {
          "test": "all",
        },
        "rules": {
          "complexity": {
            "noExcessiveNestedTestSuites": "off",
          },
          "style": {
            "useConsistentTestIt": "error",
            "useTestHooksInOrder": "error",
            "useTestHooksOnTop": "error",
          },
        },
      },
    },
  ],
  "plugins": [
    {
      "path": "./.droneey/constitution/presets/typescript/biome/foundation/plugins/test-never-skipped-or-empty.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/foundation/plugins/module-never-mocked-in-a-spec.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/foundation/plugins/strict-matcher-only.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/foundation/plugins/failed-test-never-retried.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/foundation/plugins/spec-never-sleeps.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
  ],
}
