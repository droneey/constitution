{
  "overrides": [
    {
      "includes": [
        "**/*.ts",
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
            "useExhaustiveDependencies": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
            "useExhaustiveDependencies": "error",
            "noChildrenProp": "error",
            "useJsxKeyInIterable": "error",
            "noNestedComponentDefinitions": "error",
            "noReactPropAssignments": "error",
          },
          "nursery": {
            "noComponentHookFactories": "error",
            "useReactCompiler": "error",
            "noReactStringRefs": "error",
            "useReactNamingConvention": "error",
            "useReactFunctionComponentDefinition": {
              "level": "error",
              "options": {
                "namedComponents": "functionDeclaration",
              },
            },
          },
          "suspicious": {
            "noArrayIndexKey": "error",
            "noReactForwardRef": "error",
            "noLeakedRender": "error",
            "noDuplicateJsxProps": "error",
            "noDuplicatedSpreadProps": "error",
          },
          "style": {
            "useFragmentSyntax": "error",
            "useComponentExportOnlyModules": "off",
            "useReactFunctionComponents": "error",
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": {
                      "kind": "typeParameter",
                    },
                    "match": "T([A-Z].*)?",
                    "formats": [
                      "PascalCase",
                    ],
                  },
                  {
                    "selector": {
                      "kind": "objectLiteralProperty",
                    },
                    "match": "[_$]*([^_$].*?)[_$]*",
                    "formats": [
                      "camelCase",
                      "PascalCase",
                    ],
                  },
                  {
                    "selector": {
                      "kind": "typeProperty",
                    },
                    "match": "[_$]*([^_$].*?)[_$]*",
                    "formats": [
                      "camelCase",
                      "PascalCase",
                    ],
                  },
                ],
              },
            },
            "useConsistentCurlyBraces": "error",
            "useSelfClosingElements": "error",
          },
          "performance": {
            "noJsxPropsBind": "off",
          },
          "complexity": {
            "noUselessFragments": "error",
          },
        },
      },
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
    },
  ],
  "plugins": [
    "./.droneey/constitution/presets/typescript/biome/foundation/plugins/modern-react-api-only.grit",
    {
      "path": "./.droneey/constitution/presets/typescript/biome/foundation/plugins/nothing-rendered-as-null.grit",
      "includes": [
        "**/*.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/foundation/plugins/compound-parts-share-the-root-context.grit",
      "includes": [
        "**/*.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/foundation/plugins/file-is-one-semantic-unit.grit",
      "includes": [
        "**/*.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/foundation/plugins/react-compiler-on.grit",
      "includes": [
        "**/*.ts",
        "**/*.tsx",
      ],
    },
  ],
}
