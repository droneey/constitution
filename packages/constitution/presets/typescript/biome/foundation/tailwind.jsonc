{
  "plugins": [
    "./.droneey/constitution/presets/typescript/biome/foundation/plugins/screen-sized-classes-never-used.grit",
    "./.droneey/constitution/presets/typescript/biome/foundation/plugins/mobile-first-breakpoints.grit",
    "./.droneey/constitution/presets/typescript/biome/foundation/plugins/focus-shown-by-focusable-utility.grit",
    "./.droneey/constitution/presets/typescript/biome/foundation/plugins/logical-utilities-for-direction.grit",
    "./.droneey/constitution/presets/typescript/biome/foundation/plugins/important-modifier-never-in-a-class-list.grit",
    "./.droneey/constitution/presets/typescript/biome/foundation/plugins/transition-all-never-used.grit",
  ],
  "linter": {
    "rules": {
      "nursery": {
        "noTailwindArbitraryValue": "error",
        "noTailwindRawColors": "error",
        "noUndeclaredClasses": "off",
      },
    },
  },
}
