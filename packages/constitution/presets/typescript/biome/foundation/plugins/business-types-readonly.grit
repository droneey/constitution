language js

or {
  TsPropertySignatureTypeMember(),
  TsIndexSignatureTypeMember()
} as $field where {
  $field <: not r"(?s)readonly\s.*",
  $field <: not within or {
    `Readonly<$_>`,
    JsFormalParameter(),
    TsFunctionType()
  },
  register_diagnostic(span=$field, message="[business-types-readonly] A field of a business type that is not readonly: the value is shared, and a change made in place goes unseen", severity="error")
}
