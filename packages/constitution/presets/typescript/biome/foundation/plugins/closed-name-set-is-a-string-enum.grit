language js

or {
  TsIndexedAccessType(object_type=$object, index_type=$index) as $set where {
    $object <: or {
      TsParenthesizedType(ty=TsTypeofType(expression_name=$name)),
      TsTypeofType(expression_name=$name)
    },
    $index <: or {
      TsNumberType() where {
        $program <: not contains `const $name = [$members] as const` where {
          $members <: every JsStaticMemberExpression()
        }
      },
      TsTypeOperatorType()
    },
    register_diagnostic(span=$set, message="[closed-name-set-is-a-string-enum] A closed set of named values is a string enum, not a type taken from an as-const array", severity="error")
  },
  TsUnionType(types=$members) as $union where {
    $members <: every TsStringLiteralType(),
    $union <: not within or {
      `Omit<$_, $_>`,
      `Pick<$_, $_>`,
      `Exclude<$_, $_>`,
      `Extract<$_, $_>`
    },
    register_diagnostic(span=$union, message="[closed-name-set-is-a-string-enum] A closed set of named values is a string enum, not a union of string literals", severity="error")
  }
}
