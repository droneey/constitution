language js

pattern pascal_case() { r"[A-Z][A-Za-z0-9]*" }

pattern component_function() {
  or {
    JsArrowFunctionExpression(),
    JsFunctionExpression(),
    JsCallExpression(callee=$callee) where { $callee <: r"(?:[A-Za-z]+\.)?(?:memo|forwardRef)" }
  }
}

pattern declared_function($module) {
  $name where {
    $module <: contains or {
      JsFunctionDeclaration(id=$name),
      JsVariableDeclarator(id=$name, initializer=JsInitializerClause(expression=component_function()))
    }
  }
}

// A compound is the component its parts are attached to by Object.assign.
pattern component_value($module) {
  or {
    component_function(),
    `Object.assign($root, $_)` where {
      $root <: or {
        component_function(),
        and { pascal_case(),
        declared_function($module) }
      }
    }
  }
}

pattern component_named($module) {
  $name where {
    $name <: pascal_case(),
    $module <: contains or {
      JsFunctionDeclaration(id=$name),
      JsVariableDeclarator(id=$name, initializer=JsInitializerClause(expression=component_value($module)))
    }
  }
}

pattern value_declared($module) {
  $name where {
    $module <: contains or {
      JsFunctionDeclaration(id=$name),
      JsVariableDeclarator(id=$name),
      JsClassDeclaration(id=$name),
      TsEnumDeclaration(id=$name)
    }
  }
}

pattern type_declared($module) {
  $name where {
    $module <: contains or {
      TsTypeAliasDeclaration(binding_identifier=$name),
      TsInterfaceDeclaration(id=$name)
    }
  }
}

// A local value that is no component, or an imported name in no component's case.
pattern non_component_name($module) {
  $name where {
    $name <: not component_named($module),
    or {
      $name <: value_declared($module),
      and { $name <: not type_declared($module), $name <: not pascal_case() }
    }
  }
}

pattern exports_component($module) {
  contains or {
    JsExport(export_clause=JsFunctionDeclaration(id=pascal_case())),
    JsExport(export_clause=JsVariableDeclarationClause()) as $statement where {
      $statement <: contains JsVariableDeclarator(id=pascal_case(), initializer=JsInitializerClause(expression=component_value($module)))
    },
    JsExportNamedShorthandSpecifier(name=component_named($module)),
    JsExportNamedSpecifier(local_name=component_named($module))
  }
}

pattern type_only_export() {
  or {
    includes r"^type\s",
    within JsExportNamedClause() as $clause where { $clause <: includes r"^type\s" },
    within JsExportNamedFromClause() as $clause where { $clause <: includes r"^type\s" }
  }
}

// A value a module exports beside its components.
pattern non_component_export($module) {
  or {
    or {
      JsExportNamedShorthandSpecifier(name=$name),
      JsExportNamedSpecifier(local_name=$name)
    } as $export where { $export <: not type_only_export(), $name <: non_component_name($module) },
    JsExportNamedFromSpecifier(source_name=$name) as $export where {
      $export <: not type_only_export(),
      $name <: not pascal_case()
    },
    JsExport(export_clause=JsFunctionDeclaration(id=$name)) where { $name <: not pascal_case() },
    JsVariableDeclarator(id=$name, initializer=JsInitializerClause(expression=$value)) as $export where {
      $export <: within JsExport(),
      $export <: not within JsFunctionBody(),
      not and { $name <: pascal_case(), $value <: component_value($module) }
    },
    JsExport(export_clause=or {
      JsClassDeclaration(),
      TsEnumDeclaration(),
      JsExportDefaultExpressionClause(),
      JsExportFromClause()
    })
  }
}

// Whether the module exports a component is asked once, before its exports,
// whose kinds come first since Biome tells a kind apart without copying its
// matching state.
file(body=$module) where {
  $module <: JsModule(),
  $module <: exports_component($module),
  $module <: contains or {
    JsExportNamedShorthandSpecifier(),
    JsExportNamedSpecifier(),
    JsExportNamedFromSpecifier(),
    JsExport(),
    JsVariableDeclarator()
  } as $export where {
    $export <: non_component_export($module),
    register_diagnostic(span=$export, message="[file-is-one-semantic-unit] A module that exports a component exports only components, so Fast Refresh can swap it: move this value into a file of its own", severity="error"),
    // Biome keeps what a match adds to its matching state and copies that
    // state at every node, so each match would slow the next: the diagnostic
    // stays, the match fails.
    false
  }
}
