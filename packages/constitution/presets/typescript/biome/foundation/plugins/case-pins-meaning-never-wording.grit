language js

// Prose is three words in a row, each opened by a letter and parted by spaces; a code, a path, an id
// or a number is not.
pattern prose() {
  or {
    JsStringLiteralExpression(),
    JsTemplateExpression(),
    JsRegexLiteralExpression()
  } as $text where {
    $text <: includes r"\p{L}[\p{L}\p{N}'’-]* +\p{L}[\p{L}\p{N}'’-]* +\p{L}[\p{L}\p{N}'’-]*"
  }
}

pattern matcher() {
  or {
    `toBe`,
    `toEqual`,
    `toStrictEqual`,
    `toContain`,
    `toMatch`,
    `toStartWith`,
    `toEndWith`,
    `toThrow`,
    `toThrowError`
  }
}

// Prose written as an assertion's expected value; a value a case reads from a row of its table is
// data, and the table is the one place its wording is pinned.
JsCallExpression(callee=JsStaticMemberExpression(member=matcher()), arguments=JsCallArguments(args=[
  prose() as $wording
])) where {
  register_diagnostic(span=$wording, message="[case-pins-meaning-never-wording] Compare what the outcome means — its code, its subject, the values it names — and pin the wording once, in the one table of its renderer", severity="error"),
  // Biome keeps what a match adds to its matching state and copies that state
  // before every node, so each match would slow the next: the diagnostic stays,
  // the match fails.
  false
}
