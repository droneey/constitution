{
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true,
    },
  },
  "overrides": [
    {
      "includes": [
        "**/*.ts",
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noStaticOnlyClass": "off",
          },
          "style": {
            "noParameterProperties": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.controller.ts",
        "**/*.provider.ts",
        "**/*.filter.ts",
        "**/*.pipe.ts",
        "**/*.guard.ts",
        "**/*.interceptor.ts",
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": "off",
          },
          "style": {
            "useImportType": "off",
          },
        },
      },
    },
  ],
}
