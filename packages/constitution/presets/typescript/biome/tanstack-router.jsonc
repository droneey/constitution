{
  "overrides": [
    {
      "includes": [
        "**/src/root/routes/**",
        "**/src/root/routeTree.gen.ts",
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off",
          },
        },
      },
    },
  ],
  "plugins": [
    {
      "path": "./.droneey/constitution/presets/typescript/biome/plugins/links-name-typed-targets.grit",
      "includes": [
        "**/*.ts",
        "**/*.tsx",
      ],
    },
  ],
}
