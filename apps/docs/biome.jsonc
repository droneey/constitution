{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "files": {
    "includes": [
      // biome
      "**",
      "!!**/.droneey",

      // ast-grep
      "!!**/ast-grep.gen",
      "!!**/ast-grep-utils.gen",

      // mise
      "!!**/.mise/locks",
      "!**/*.gen.*",
    ],

    // biome
    "ignoreUnknown": true,
  },
  "overrides": [
    // biome
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/tests/**",
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.gen.*",
        "**/*.gen/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/tests/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/tests/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.gen.*",
        "**/*.gen/**",
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/tests/**",
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/*.config.cjs",
        "**/.*rc.ts",
        "**/.*rc.js",
        "**/.*rc.mjs",
        "**/.*rc.cjs",
      ],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/tests/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": true,
                "filenameCases": [
                  "kebab-case",
                ],
                "match": "([^.]+)[.]((?:[^.]+[.])?(?:integration[.]|e2e[.])?(?:test|fake|suite|fixtures)[.]tsx?)",
              },
            },
          },
        },
      },
    },
    {
      "includes": [
        "**/use-cases/queries/**",
        "!**/__tests__/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "moment": "Use Temporal: date libraries wrap the Date it replaces",
                  "dayjs": "Use Temporal: date libraries wrap the Date it replaces",
                  "date-fns": "Use Temporal: date libraries wrap the Date it replaces",
                  "luxon": "Use Temporal: date libraries wrap the Date it replaces",
                },
                "patterns": [
                  {
                    "group": [
                      "moment/**",
                      "dayjs/**",
                      "date-fns/**",
                      "luxon/**",
                    ],
                    "message": "Use Temporal: date libraries wrap the Date it replaces",
                  },
                  {
                    "group": [
                      "**",
                    ],
                    "importNamePattern": ".*Repository",
                    "message": "A query's use case reads through a queries port, never a repository.",
                  },
                  {
                    "group": [
                      "**",
                    ],
                    "importNamePattern": "\\*",
                    "message": "A use case imports each port by its name, never a whole surface as a namespace, so the side of each port it takes shows.",
                  },
                ],
              },
            },
          },
        },
      },
    },
    {
      "includes": [
        "**/use-cases/commands/**",
        "!**/__tests__/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "moment": "Use Temporal: date libraries wrap the Date it replaces",
                  "dayjs": "Use Temporal: date libraries wrap the Date it replaces",
                  "date-fns": "Use Temporal: date libraries wrap the Date it replaces",
                  "luxon": "Use Temporal: date libraries wrap the Date it replaces",
                },
                "patterns": [
                  {
                    "group": [
                      "moment/**",
                      "dayjs/**",
                      "date-fns/**",
                      "luxon/**",
                    ],
                    "message": "Use Temporal: date libraries wrap the Date it replaces",
                  },
                  {
                    "group": [
                      "**",
                    ],
                    "importNamePattern": ".*Queries",
                    "message": "A command's use case takes the repositories of the aggregates it loads, never a queries port.",
                  },
                  {
                    "group": [
                      "**",
                    ],
                    "importNamePattern": "\\*",
                    "message": "A use case imports each port by its name, never a whole surface as a namespace, so the side of each port it takes shows.",
                  },
                ],
              },
            },
          },
        },
      },
    },

    // biome
    {
      "includes": [
        "**/src/**",
        "!**/src/infrastructure/**",
        "!**/src/features/*/infrastructure/**",
        "!**/src/composition/*/infrastructure/**",
        "!**/src/libs/**",
        "!**/src/root/**",
        "!**/src/*.ts",
        "!**/src/*.tsx",
        "!**/src/entrypoints/*/main.*",
        "!**/src/integrations/**",
        "!**/__tests__/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "EventSource": "Outside the edge, the network reaches this code through a port.",
                  "WebSocket": "Outside the edge, the network reaches this code through a port.",
                  "XMLHttpRequest": "Outside the edge, the network reaches this code through a port.",
                  "fetch": "Outside the edge, the network reaches this code through a port.",
                  "indexedDB": "Outside the edge, storage reaches this code through a port.",
                  "localStorage": "Outside the edge, storage reaches this code through a port.",
                  "performance": "Outside the edge, the clock reaches this code through a port.",
                  "process": "Outside the edge, the process, its streams and its arguments reach this code through a port.",
                  "caches": "Outside the edge, input and output reach this code through a port.",
                  "cookieStore": "Outside the edge, input and output reach this code through a port.",
                  "document": "Outside the edge, input and output reach this code through a port.",
                  "globalThis": "Outside the edge, input and output reach this code through a port.",
                  "navigator": "Outside the edge, input and output reach this code through a port.",
                  "self": "Outside the edge, input and output reach this code through a port.",
                  "window": "Outside the edge, input and output reach this code through a port.",
                  "sessionStorage": "Outside the edge, storage reaches this code through a port.",
                },
              },
            },
          },
        },
      },
    },

    // js-runtime/bun
    {
      "includes": [
        "**/src/**",
        "!**/src/infrastructure/**",
        "!**/src/features/*/infrastructure/**",
        "!**/src/composition/*/infrastructure/**",
        "!**/src/libs/**",
        "!**/src/root/**",
        "!**/src/*.ts",
        "!**/src/*.tsx",
        "!**/src/entrypoints/*/main.*",
        "!**/src/integrations/**",
        "!**/__tests__/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "EventSource": "Outside the edge, the network reaches this code through a port.",
                  "WebSocket": "Outside the edge, the network reaches this code through a port.",
                  "XMLHttpRequest": "Outside the edge, the network reaches this code through a port.",
                  "fetch": "Outside the edge, the network reaches this code through a port.",
                  "indexedDB": "Outside the edge, storage reaches this code through a port.",
                  "localStorage": "Outside the edge, storage reaches this code through a port.",
                  "performance": "Outside the edge, the clock reaches this code through a port.",
                  "process": "Outside the edge, the process, its streams and its arguments reach this code through a port.",
                  "caches": "Outside the edge, input and output reach this code through a port.",
                  "cookieStore": "Outside the edge, input and output reach this code through a port.",
                  "document": "Outside the edge, input and output reach this code through a port.",
                  "globalThis": "Outside the edge, input and output reach this code through a port.",
                  "navigator": "Outside the edge, input and output reach this code through a port.",
                  "self": "Outside the edge, input and output reach this code through a port.",
                  "window": "Outside the edge, input and output reach this code through a port.",
                  "sessionStorage": "Outside the edge, storage reaches this code through a port.",
                  "Bun": "Outside the edge, Bun's files, processes, environment and network reach this code through a port.",
                },
              },
            },
          },
        },
      },
    },

    // typescript
    {
      "includes": [
        "**/*.config.ts",
        "**/.*rc.ts",
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useExplicitReturnType": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.d.ts",
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentMemberAccessibility": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useExplicitReturnType": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.d.ts",
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/*.config.cjs",
        "**/.*rc.ts",
        "**/.*rc.js",
        "**/.*rc.mjs",
        "**/.*rc.cjs",
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.d.ts",
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/components/**",
        "!**/__tests__/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "EventSource": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "WebSocket": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "XMLHttpRequest": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "fetch": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "indexedDB": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "localStorage": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "performance": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "process": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "caches": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "cookieStore": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "document": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "globalThis": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "navigator": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "self": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "window": "A component takes its data and callbacks as props; input and output go through binding units.",
                  "sessionStorage": "A component takes its data and callbacks as props; input and output go through binding units.",
                },
              },
            },
          },
        },
      },
    },

    // biome
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noStaticOnlyClass": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noIdenticalTestTitle": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.jsonc",
      ],
      "json": {
        "formatter": {
          "trailingCommas": "all",
        },
      },
    },

    // bun-test
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "domains": {
          "test": "all",
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveNestedTestSuites": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTestIt": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "style": {
            "useTestHooksInOrder": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "style": {
            "useTestHooksOnTop": "error",
          },
        },
      },
    },

    // dependency-cruiser
    {
      "includes": [
        "**/.dependency-cruiser.js",
        "**/.dependency-cruiser.mjs",
        "**/.dependency-cruiser.cjs",
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/.dependency-cruiser.js",
        "**/.dependency-cruiser.mjs",
        "**/.dependency-cruiser.cjs",
      ],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off",
          },
        },
      },
    },

    // react
    {
      "includes": [
        "**/*.ts",
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.ts",
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "correctness": {
            "noChildrenProp": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "nursery": {
            "useReactNamingConvention": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "nursery": {
            "useReactFunctionComponentDefinition": {
              "level": "error",
              "options": {
                "namedComponents": "functionDeclaration",
              },
            },
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noLeakedRender": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateJsxProps": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicatedSpreadProps": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "style": {
            "useFragmentSyntax": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "style": {
            "useConsistentCurlyBraces": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "style": {
            "useSelfClosingElements": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "complexity": {
            "noUselessFragments": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
