    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": {
                      "kind": "typeParameter",
                    },
                    "match": "T([A-Z].*)?",
                    "formats": [
                      "PascalCase",
                    ],
                  },
                  {
                    "selector": {
                      "kind": "objectLiteralProperty",
                    },
                    "match": "[_$]*([^_$].*?)[_$]*",
                    "formats": [
                      "camelCase",
                      "PascalCase",
                    ],
                  },
                  {
                    "selector": {
                      "kind": "typeProperty",
                    },
                    "match": "[_$]*([^_$].*?)[_$]*",
                    "formats": [
                      "camelCase",
                      "PascalCase",
                    ],
                  },
                ],
              },
            },
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
