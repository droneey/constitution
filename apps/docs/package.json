{
  "name": "@droneey/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The Constitution's site: its documentation and its blocks, rendered from the repository.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#collections/*": "./.source/*.ts"
  },
  "scripts": {
    "build": "vite build",
    "check": "bun run --sequential 'check:*' test mutate:branch",
    "check:architecture": "depcruise src --config .dependency-cruiser.jsonc",
    "check:audit-image": "docker build --quiet --target base --tag audit-image:base --file docker/images/app.Dockerfile ../.. && { osv-scanner scan image $(test -f osv-scanner.toml && echo --config osv-scanner.toml) audit-image:base; status=$?; docker rmi audit-image:base > /dev/null; exit $status; }",
    "check:compose": "dclint compose.yaml docker/compose/app.yaml",
    "check:dockerfile": "hadolint docker/images/app.Dockerfile",
    "check:duplicates": "jscpd",
    "check:lint": "biome check --error-on-warnings",
    "check:markdown": "rumdl check . && rumdl fmt --check .",
    "check:shell": "git ls-files -z --cached --others --exclude-standard -- '*.sh' '*.bash' | xargs -0 -r sh -c \"for file do if [ -e \\\"\\$file\\\" ]; then printf '%s\\0' \\\"\\$file\\\"; fi; done\" sh | xargs -0 -r shellcheck",
    "check:shell-format": "git ls-files -z --cached --others --exclude-standard -- '*.sh' '*.bash' | xargs -0 -r sh -c \"for file do if [ -e \\\"\\$file\\\" ]; then printf '%s\\0' \\\"\\$file\\\"; fi; done\" sh | xargs -0 -r shfmt -d",
    "check:toml": "tombi format --check && tombi lint",
    "check:types": "tsc -b",
    "check:unused": "knip --no-config-hints && knip --strict --no-config-hints",
    "check:yaml": "yamllint --strict .",
    "fix": "bun run --sequential 'fix:*'",
    "fix:lint": "biome check --write",
    "fix:markdown": "rumdl check --fix",
    "fix:shell-format": "git ls-files -z --cached --others --exclude-standard -- '*.sh' '*.bash' | xargs -0 -r sh -c \"for file do if [ -e \\\"\\$file\\\" ]; then printf '%s\\0' \\\"\\$file\\\"; fi; done\" sh | xargs -0 -r shfmt -w",
    "fix:toml": "tombi format",
    "mutate:all": "mutation-check all",
    "mutate:branch": "mutation-check",
    "postinstall": "fumadocs-mdx",
    "prebuild": "bun run --filter '@droneey/docs^...' generate",
    "precheck": "bun run --filter '@droneey/docs^...' generate",
    "premutate:all": "bun run --filter '@droneey/docs^...' generate",
    "prerun:dev": "bun run --filter '@droneey/docs^...' generate",
    "pretest": "bun run --filter '@droneey/docs^...' generate",
    "run:dev": "vite dev",
    "run:preview": "vite preview",
    "test": "bun run --parallel 'test:*'",
    "test:integration": "CI=1 bun --config=./bunfig.integration.toml test",
    "test:unit": "CI=1 bun test"
  },
  "dependencies": {
    "@droneey/constitution": "workspace:*",
    "@droneey/constitution-brand": "workspace:*",
    "@droneey/design-browser": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "^16.17.5",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.17.5",
    "hast-util-from-html": "^2.0.3",
    "lucide-react": "^1.57.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "takumi-js": "^2.16.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@biomejs/biome": "2.6.3",
    "@droneey/mutation-check-typescript": "workspace:*",
    "@happy-dom/global-registrator": "21.0.4",
    "@rolldown/plugin-babel": "0.2.4",
    "@stryker-mutator/core": "10.1.1",
    "@swc/core": "1.16.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.7.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "nitro": "3.0.260903-beta",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vite": "8.3.4"
  },
  "trustedDependencies": []
}
