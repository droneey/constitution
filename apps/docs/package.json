{
  "name": "@droneey/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The Constitution's site: its documentation and its blocks, rendered from the repository.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#collections/*": "./.source/*.ts"
  },
  "scripts": {
    "predev": "bun run --filter '@droneey/docs^...' build",
    "dev": "vite dev",
    "prebuild": "bun run --filter '@droneey/docs^...' build",
    "build": "vite build",
    "prebuild:release": "bun run --filter '@droneey/docs^...' build",
    "build:release": "vite build --mode release",
    "preview": "vite preview",
    "postinstall": "fumadocs-mdx",
    "lint:check": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "pretype:check": "bun run --filter '@droneey/docs^...' build",
    "type:check": "tsc -b",
    "pretest": "bun run --filter '@droneey/docs^...' build",
    "test": "CI=1 bun test",
    "premutation:check": "bun run --filter '@droneey/docs^...' build",
    "mutation:check": "mutation-check",
    "premutation:all": "bun run --filter '@droneey/docs^...' build",
    "mutation:all": "mutation-check all",
    "architecture:check": "depcruise src --config .dependency-cruiser.mjs",
    "docker:check": "mise run dockerfile:check && mise run compose:check",
    "unused:check": "knip --no-config-hints && knip --strict --no-config-hints",
    "shell:check": "shellcheck scripts/*.sh && shfmt -d scripts",
    "audit:check": "mise run audit:check",
    "markdown:check": "rumdl check . && rumdl fmt --check .",
    "markdown:fix": "rumdl check --fix",
    "yaml:check": "yamllint --strict .",
    "toml:check": "tombi format --check && tombi lint",
    "toml:fix": "tombi format"
  },
  "dependencies": {
    "@droneey/constitution": "workspace:*",
    "@droneey/design-browser": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "^16.17.5",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.17.5",
    "hast-util-from-html": "^2.0.3",
    "lucide-react": "^1.57.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "takumi-js": "^2.16.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@biomejs/biome": "2.6.2",
    "@droneey/mutation-check": "workspace:*",
    "@happy-dom/global-registrator": "21.0.3",
    "@rolldown/plugin-babel": "0.2.4",
    "@stryker-mutator/core": "10.0.0",
    "@swc/core": "1.16.18",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.7.0",
    "knip": "6.41.0",
    "nitro": "3.0.260903-beta",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vite": "8.3.4"
  }
}
