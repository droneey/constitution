{
  "entry": [
    // knip
    "src/main.{ts,tsx}!",
    "scripts/*/main.ts",

    // tanstack-start
    "src/router.{ts,tsx}!",
    "src/client.{ts,tsx}!",

    // knip
    "src/entrypoints/*/main.{ts,tsx}!",
    "src/**/index.{ts,tsx}!",

    // tanstack-router
    "src/root/routes/**/*.{ts,tsx}!",

    // tanstack-start
    "src/root/router.{ts,tsx}!",
    "source.config.ts!",
  ],
  "fumadocs": false,
  "ignore": [
    "src/root/routeTree.gen.ts",
  ],

  // stryker
  "ignoreDependencies": [
    "@stryker-mutator/bun-specs-runner",
    "@fontsource-variable/geist",
    "@fontsource-variable/geist-mono",
    "tailwindcss",
    "@stryker-mutator/core",
    "@swc/core",
  ],

  // knip
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/__tests__/**!",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts",
  ],
  "ignoreBinaries": [
    // dclint
    "dclint",

    // hadolint
    "hadolint",

    // mise
    "mise",

    // osv-scanner
    "osv-scanner",

    // rumdl
    "rumdl",

    // shellcheck
    "shellcheck",

    // shfmt
    "shfmt",

    // tombi
    "tombi",

    // yamllint
    "yamllint",
  ],
}
