{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "@droneey/devkit-ts-biome/base",
    "@droneey/devkit-ts-biome/node",
    "@droneey/devkit-ts-biome/test"
  ],
  "files": {
    "includes": [
      "**",
      "!**/coverage"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": false
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/**/adapters/**"
      ],
      "plugins": [
        "./biome/no-null.grit"
      ]
    },
    {
      "includes": [
        ".syncpackrc.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off",
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": [
                  "kebab-case"
                ],
                "match": "([^.]+)[.]((?:[^.]+[.])?(?:integration[.])?(?:spec|fake|fixtures)[.]ts)"
              }
            }
          },
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
