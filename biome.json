{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "@droneey/devkit-ts-biome/base",
    "@droneey/devkit-ts-biome/node",
    "@droneey/devkit-ts-biome/test",
    "./.constitution/presets/biome/base.jsonc",
    "./.constitution/presets/biome/bun-test.jsonc"
  ],
  "overrides": [
    {
      "includes": [
        ".syncpackrc.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/__tests__/**",
        "tests/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off",
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": [
                  "kebab-case"
                ],
                "match": "([^.]+)[.]((?:[^.]+[.])?(?:integration[.]|e2e[.])?(?:spec|fake|fixtures)[.]ts)"
              }
            }
          },
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
