{
  "extends": [
    "./.droneey/constitution/presets/typescript/tsc/foundation/self.json",
    "./.droneey/constitution/presets/typescript/tsc/foundation/core.json",
    "./.droneey/constitution/presets/typescript/tsc/foundation/bun.json"
  ],
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "paths": {
      "#/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "tools/*/src/**/*.ts"
  ],
  "exclude": [
    "**/coverage"
  ]
}
