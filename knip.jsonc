{
  "ignoreWorkspaces": [
    "apps/*",
    "packages/*",
    "packages/*/languages/typescript",
  ],
  "ignoreBinaries": [
    "betterleaks",
    "lefthook",
    "mise",
    "osv-scanner",
    "rumdl",
    "shellcheck",
    "shfmt",
    "tombi",
    "uv",
    "yamllint",
    "actionlint",
    "renovate-config-validator",
  ],
  "entry": [
    "src/main.{ts,tsx}!",
    "scripts/*/main.ts",
    "src/entrypoints/*/main.{ts,tsx}!",
    "src/**/index.{ts,tsx}!",
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/**/__tests__/**!",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts",
  ],
}
