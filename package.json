{
  "name": "@droneey/constitution-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "The workspace of the Droneey Constitution: its rules and the tools that hold them.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "email": "me@kurovskyi.dev",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git"
  },
  "type": "module",
  "scripts": {
    "check": "bun run --sequential 'check:*'",
    "check:audit": "osv-scanner scan source --licenses=\"0BSD,Apache-2.0,BlueOak-1.0.0,BSD-2-Clause,BSD-3-Clause,CC-BY-4.0,CC0-1.0,ISC,MIT,MIT-0,MPL-2.0,OFL-1.1,PSF-2.0,Python-2.0,Unlicense,Zlib\" --no-ignore .",
    "check:lint": "biome check --error-on-warnings",
    "check:manifests": "syncpack lint && syncpack format --check",
    "check:markdown": "rumdl check . && rumdl fmt --check .",
    "check:renovate": "renovate-config-validator --strict",
    "check:secrets": "betterleaks git . --redact --no-banner && betterleaks git . --pre-commit --redact --no-banner && betterleaks git . --pre-commit --staged --redact --no-banner",
    "check:shell": ".droneey/constitution/presets/shell/run-on-shell-scripts.sh shellcheck -- 'apps/docs' 'packages/@design/browser' 'packages/@design/cli' 'packages/@design/tokens' 'packages/@mutation-check/python' 'packages/@mutation-check/typescript' 'packages/brand' 'packages/constitution' 'packages/python-check'",
    "check:shell-format": ".droneey/constitution/presets/shell/run-on-shell-scripts.sh shfmt -d -- 'apps/docs' 'packages/@design/browser' 'packages/@design/cli' 'packages/@design/tokens' 'packages/@mutation-check/python' 'packages/@mutation-check/typescript' 'packages/brand' 'packages/constitution' 'packages/python-check'",
    "check:toml": "tombi format --check && tombi lint",
    "check:workflows": "actionlint -pyflakes=",
    "check:yaml": "yamllint --strict .",
    "constitution": "bun run --filter '@droneey/constitution^...' generate && bun packages/constitution/src/main.ts",
    "fix": "bun run --sequential 'fix:*'",
    "fix:lint": "biome check --write",
    "fix:manifests": "syncpack fix && syncpack format",
    "fix:markdown": "rumdl check --fix",
    "fix:shell-format": ".droneey/constitution/presets/shell/run-on-shell-scripts.sh shfmt -w -- 'apps/docs' 'packages/@design/browser' 'packages/@design/cli' 'packages/@design/tokens' 'packages/@mutation-check/python' 'packages/@mutation-check/typescript' 'packages/brand' 'packages/constitution' 'packages/python-check'",
    "fix:toml": "tombi format"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/@design/*",
    "packages/@mutation-check/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "jscpd": "5.4.2",
    "syncpack": "15.3.3"
  },
  "resolutions": {
    "fast-uri": "3.1.9",
    "happy-dom": "21.0.4",
    "minimatch": "11.0.1",
    "qs": "6.16.1",
    "seroval": "1.6.11",
    "seroval-plugins": "1.6.11"
  },
  "trustedDependencies": []
}
