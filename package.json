{
  "name": "@droneey/constitution",
  "version": "0.62.11",
  "private": true,
  "description": "The engineering constitution of droneey: blocks of rules a project declares in constitution.yaml.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "lint:check": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "packages:check": "syncpack lint && syncpack format --check",
    "packages:fix": "syncpack fix && syncpack format",
    "type:check": "tsc --noEmit",
    "test:unit": "CI=1 bun test",
    "test:e2e": "CI=1 bun --config=./bunfig.e2e.toml test",
    "test": "bun run test:unit && bun run test:e2e",
    "blocks:check": "bun run ./src/entrypoints/blocks-check/main.ts",
    "digests:write": "bun run ./src/entrypoints/digests-write/main.ts",
    "build": "bun build --target=bun --packages=external ./tools/mutation-check/src/main.ts --outdir tools/mutation-check/dist",
    "mutation:check": "bun tools/mutation-check/src/main.ts",
    "mutation:all": "bun tools/mutation-check/src/main.ts all",
    "secrets:check": "betterleaks git . --redact --no-banner && betterleaks git . --pre-commit --redact --no-banner && betterleaks git . --pre-commit --staged --redact --no-banner",
    "architecture:check": "depcruise src tests tools --config .dependency-cruiser.mjs",
    "unused:check": "knip --no-config-hints && knip --strict --no-config-hints",
    "audit:check": "osv-scanner scan source --licenses=\"$(paste -sd, .droneey/constitution/presets/common/osv-scanner/foundation/core.txt)\" .",
    "names:check": "ls-lint --config .droneey/constitution/presets/common/ls-lint/foundation/self.yaml --config .droneey/constitution/presets/common/ls-lint/foundation/core.yaml --config .droneey/constitution/presets/typescript/ls-lint/foundation/typescript.yaml --config .droneey/constitution/presets/common/ls-lint/foundation/git.yaml --config .droneey/constitution/presets/common/ls-lint/foundation/mise.yaml --config .droneey/constitution/presets/common/ls-lint/foundation/stryker.yaml --config .droneey/constitution/presets/typescript/ls-lint/architecture/core.yaml --config .ls-lint.yaml",
    "check": "bun run lint:check && bun run packages:check && bun run type:check && bun run architecture:check && bun run test && bun run mutation:check && bun run blocks:check && bun run secrets:check && bun run names:check && bun run unused:check && bun run audit:check"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@stryker-mutator/core": "^10.0.0",
    "@swc/core": "^1.16.2",
    "@types/bun": "^1.4.1",
    "@types/node": "^26",
    "dclint": "^3.1.0",
    "dependency-cruiser": "^18.4.0",
    "knip": "^6.38.0",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": []
}
