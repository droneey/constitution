{
  "name": "@droneey/constitution",
  "version": "0.33.0",
  "private": true,
  "description": "The engineering constitution of droneey: blocks of rules a project declares in constitution.yaml.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Dmytro Kurovskyi",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/constitution.git"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "lint:check": "biome check",
    "lint:fix": "biome check --write",
    "packages:check": "syncpack lint && syncpack format --check",
    "packages:fix": "syncpack fix && syncpack format",
    "type:check": "tsc --noEmit",
    "test:unit": "bun test",
    "blocks:check": "bun run ./src/entrypoints/blocks-check/main.ts",
    "digests:write": "bun run ./src/entrypoints/digests-write/main.ts",
    "mutation:check": "bun run ./src/entrypoints/mutation-check/main.ts",
    "mutation:all": "bun run ./src/entrypoints/mutation-check/main.ts all",
    "secrets:check": "betterleaks git . --redact --no-banner && betterleaks git . --pre-commit --redact --no-banner && betterleaks git . --pre-commit --staged --redact --no-banner",
    "architecture:check": "depcruise src e2e --config .dependency-cruiser.mjs",
    "check": "bun run lint:check && bun run packages:check && bun run type:check && bun run architecture:check && bun run test:unit && bun run mutation:check && bun run blocks:check && bun run secrets:check"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@droneey/devkit-ts-biome": "^1.22.1",
    "@droneey/devkit-ts-dependency-cruiser": "^1.23.0",
    "@droneey/devkit-ts-syncpack": "^1.22.1",
    "@droneey/devkit-ts-tsconfig": "^1.22.1",
    "@stryker-mutator/core": "^9.6.1",
    "@swc/core": "^1.16.2",
    "@types/bun": "^1.4.1",
    "@types/node": "^26",
    "dependency-cruiser": "^18.4.0",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2"
  }
}
