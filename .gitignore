# Caches of the Python tools when they run from the root
/.ruff_cache/
/.complexipy_cache/

# machine local files ignored
/.droneey
.claude/settings.local.json
.claude/worktrees/

# mise
mise.local.toml

# working notes stay out of history
/local/

# gitignore covers dependencies output and caches
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.log
**/logs/
.temp/
.tmp/
*.bak
*.orig
*~

# gitignore covers environment files
.env*
!.env.example

# gitignore covers key files
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
id_rsa
*.secrets

# _js-runtime
**/node_modules/
*.tgz

# bun
.npmrc

# python
__pycache__/
*.py[cod]
*.egg-info/

# rumdl
.rumdl_cache/

# tsc
*.tsbuildinfo

# tsc with workspace
.tsc-cache/

# uv
.venv/
**/dist/
