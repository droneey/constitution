{
  "css": {
    "parser": {
      "tailwindDirectives": true,
    },
  },
  "linter": {
    "rules": {
      "nursery": {
        "noUndeclaredCustomProperties": "off",
      },
    },
  },
  "plugins": [
    {
      "path": "./.droneey/constitution/presets/css/biome/foundation/plugins/theme-resets-every-default-scale.grit",
      "includes": [
        "**/*.css",
      ],
    },
  ],
}
