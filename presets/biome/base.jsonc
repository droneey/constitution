{
  "files": {
    "includes": [
      "**",
      "!**/.devkit",
      "!**/.constitution",
    ],
  },
  "plugins": [
    {
      "path": "./.constitution/presets/biome/plugins/no-null.grit",
      "includes": [
        "**",
        "!**/adapters/**",
        "!**/models/**",
      ],
    },
    {
      "path": "./.constitution/presets/biome/plugins/surface.grit",
      "includes": [
        "**/index.ts",
      ],
    },
    {
      "path": "./.constitution/presets/biome/plugins/empty-names.grit",
      "includes": [
        "**",
        "!**/src/libs/**",
      ],
    },
    {
      "path": "./.constitution/presets/biome/plugins/case-names.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
  ],
}
