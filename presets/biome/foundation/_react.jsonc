{
  "overrides": [
    {
      "includes": [
        "**/*.ts",
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
            "useExhaustiveDependencies": "error",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.tsx",
        "**/*.jsx",
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": {
              "level": "on",
              "options": {},
            },
            "noDuplicateClasses": {
              "level": "on",
              "options": {},
            },
          },
        },
      },
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
            "useExhaustiveDependencies": "error",
            "noChildrenProp": "error",
            "useJsxKeyInIterable": "error",
            "noNestedComponentDefinitions": "error",
            "noNextAsyncClientComponent": "error",
          },
          "nursery": {
            "noComponentHookFactories": "error",
            "useReactCompiler": "error",
            "noReactStringRefs": "error",
            "noInvalidFileInputAccept": "error",
            "useControlLabel": "error",
            "useReactNamingConvention": "error",
            "useReactFunctionComponentDefinition": {
              "level": "error",
              "options": {
                "namedComponents": "functionDeclaration",
              },
            },
          },
          "a11y": {
            "useButtonType": "error",
            "useAnchorContent": "error",
            "useValidAnchor": "error",
            "useAriaPropsForRole": "error",
            "useAltText": "error",
            "useHtmlLang": "error",
            "useHeadingContent": "error",
            "noRedundantRoles": "error",
            "noAutofocus": "error",
            "useKeyWithClickEvents": "error",
            "noPositiveTabindex": "error",
            "noRedundantAlt": "error",
            "noLabelWithoutControl": "error",
            "noInteractiveElementToNoninteractiveRole": "error",
            "useIframeTitle": "error",
            "noSvgWithoutTitle": "error",
            "useValidAriaValues": "error",
            "noAriaHiddenOnFocusable": "error",
            "useSemanticElements": "error",
            "useValidAriaProps": "error",
            "useValidAriaRole": "error",
            "noStaticElementInteractions": "error",
            "useFocusableInteractive": "error",
            "noNoninteractiveElementInteractions": "error",
            "noNoninteractiveElementToInteractiveRole": "error",
          },
          "suspicious": {
            "noArrayIndexKey": "error",
            "noDuplicateJsxProps": "error",
            "noReactForwardRef": "error",
            "noLeakedRender": "error",
          },
          "style": {
            "noImplicitBoolean": "error",
            "useFragmentSyntax": "error",
            "useConsistentCurlyBraces": "error",
            "useComponentExportOnlyModules": "error",
            "useSelfClosingElements": "error",
            "useReactFunctionComponents": "error",
          },
          "complexity": {
            "noUselessFragments": "error",
          },
          "security": {
            "noDangerouslySetInnerHtml": "error",
            "noBlankTarget": "error",
          },
          "performance": {
            "noJsxPropsBind": "off",
          },
        },
      },
    },
  ],
  "plugins": [
    "./.constitution/presets/biome/foundation/plugins/modern-react-api-only.grit",
    {
      "path": "./.constitution/presets/biome/foundation/plugins/no-manual-memoisation.grit",
      "includes": [
        "**/*.ts",
        "**/*.tsx",
      ],
    },
  ],
}
