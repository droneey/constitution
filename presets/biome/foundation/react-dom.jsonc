{
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAttribute": "error",
      },
      "correctness": {
        "useUniqueElementIds": "error",
      },
      "security": {
        "noDangerouslySetInnerHtmlWithChildren": "error",
      },
      "a11y": {
        "useValidAutocomplete": "error",
      },
    },
  },
  "plugins": [
    "./.constitution/presets/biome/foundation/plugins/labels-bound-with-use-id.grit",
  ],
}
