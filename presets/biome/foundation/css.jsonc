{
  "linter": {
    "rules": {
      "complexity": {
        "noImportantStyles": "error",
      },
      "correctness": {
        "noMissingVarFunction": "error",
      },
      "style": {
        "noDescendingSpecificity": "error",
      },
      "nursery": {
        "useLayeredStyles": "error",
        "useNamedLayer": "error",
        "noExcessiveSelectorClasses": {
          "level": "error",
          "options": {
            "maxClasses": 3,
          },
        },
        "noUndeclaredCustomProperties": "error",
        "noInvalidPropertyInitValue": "error",
        "noUndeclaredClasses": "error",
        "noUnusedClasses": "error",
        "noDuplicateSelectors": "error",
        "useBaseline": "error",
      },
    },
  },
  "plugins": [
    {
      "path": "./.constitution/presets/biome/foundation/plugins/styles-never-target-ids.grit",
      "includes": [
        "**/*.css",
      ],
    },
  ],
}
