{
  "linter": {
    "rules": {
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noAlert": "error",
        "noConsole": "error",
        "noSkippedTests": "error",
        "noFocusedTests": "error",
        "noDebugger": "error",
      },
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "filenameCases": [
              "kebab-case",
            ],
          },
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
          },
        },
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10,
          },
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 100,
          },
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3,
          },
        },
      },
      "security": {
        "noSecrets": {
          "level": "error",
          "options": {
            "entropyThreshold": 60,
          },
        },
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noConditionalExpect": "error",
        "noMisusedPromises": "error",
        "useExpect": "error",
      },
    },
  },
  "plugins": [
    "./.constitution/presets/biome/foundation/plugins/no-empty-verbs.grit",
    {
      "path": "./.constitution/presets/biome/foundation/plugins/no-empty-names.grit",
      "includes": [
        "**",
      ],
    },
    {
      "path": "./.constitution/presets/biome/foundation/plugins/no-skipped-or-empty-tests.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.constitution/presets/biome/foundation/plugins/cases-named-should-when.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
  ],
  "overrides": [
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noIdenticalTestTitle": "error",
          },
        },
      },
    },
  ],
}
