{
  "linter": {
    "rules": {
      "performance": {
        "noReExportAll": "error",
      },
    },
  },
  "plugins": [
    {
      "path": "./.constitution/presets/biome/foundation/plugins/no-empty-names.grit",
      "includes": [
        "**",
        "!**/src/libs/**",
      ],
    },
  ],
}
