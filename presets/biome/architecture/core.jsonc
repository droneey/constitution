{
  "linter": {
    "rules": {
      "performance": {
        "noReExportAll": "error",
      },
    },
  },
  "plugins": [
    {
      "path": "./.constitution/presets/biome/foundation/plugins/undefined-is-the-only-absence.grit",
      "includes": [
        "**",
        "!**/adapters/**",
        "!**/models/**",
      ],
    },
    {
      "path": "./.constitution/presets/biome/foundation/plugins/no-empty-names.grit",
      "includes": [
        "**",
        "!**/src/libs/**",
      ],
    },
    {
      "path": "./.constitution/presets/biome/architecture/plugins/surface-only-re-exports.grit",
      "includes": [
        "**/index.ts",
      ],
    },
  ],
}
