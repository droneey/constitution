language js

or {
  JsFunctionDeclaration(id=$name, parameters=$parameters),
  JsMethodClassMember(name=$name, parameters=$parameters),
  JsMethodObjectMember(name=$name, parameters=$parameters),
  TsMethodSignatureTypeMember(name=$name, parameters=$parameters),
  JsVariableDeclarator(id=$name, initializer=JsInitializerClause(expression=or {
    JsArrowFunctionExpression(parameters=$parameters),
    JsFunctionExpression(parameters=$parameters)
  }))
} where {
  $parameters <: JsParameters(items=[$_, $_, ...]),
  register_diagnostic(span=$name, message="Name every argument past the first: pass one options object", severity="error")
}
