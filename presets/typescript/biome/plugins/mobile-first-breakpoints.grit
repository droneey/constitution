language js

or {
  jsx_attribute(name=$name, value=$classes) where { $name <: r"className" },
  or {
    `cva($...)`,
    `cn($...)`,
    `clsx($...)`,
    `twMerge($...)`
  } as $classes where { $classes <: not within jsx_attribute() }
} where {
  $classes <: r"(?s)(?:.*[\s\x22\x27\x60])?max-[^\s:]*:.*",
  register_diagnostic(span=$classes, message="Widen from the small screen with md:, lg: and xl:: a max-* breakpoint alone undoes the base; bound a range after a minimum, as md:max-lg:", severity="error")
}
