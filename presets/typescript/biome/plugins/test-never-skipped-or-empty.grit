language js

`$runner.$variant($...)` where {
  $runner <: or {
    `test`,
    `it`,
    `describe`
  },
  $variant <: or {
    `todo`,
    `if`,
    `skipIf`,
    `todoIf`,
    `failing`
  },
  register_diagnostic(span=$runner, message="Write the case so it runs every time: no todo, conditional or expected-failure case", severity="error")
}
