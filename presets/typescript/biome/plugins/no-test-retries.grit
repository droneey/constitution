language js

`$runner($title, $body, $options)` where {
  $runner <: or {
    `test`,
    `it`,
    `describe`,
    `$_.$_`,
    `$_.each($_)`,
    `$_.$_.each($_)`
  },
  $options <: `{ $members }` where {
    $members <: some or {
      JsPropertyObjectMember(name=$name),
      JsShorthandPropertyObjectMember(name=$name)
    } as $option where {
      $name <: or {
        `retry`,
        `repeats`
      }
    }
  },
  register_diagnostic(span=$option, message="Fix or delete a flaky case; never retry it", severity="error")
}
