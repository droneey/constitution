language js

`null` as $value where {
  $value <: not within or {
    `$_ === null`,
    `$_ !== null`,
    `null === $_`,
    `null !== $_`,
    `useRef($...)`,
    `useRef<$_>($...)`,
    `RefObject<$_>`,
    `Object.create(null)`
  } ,
  register_diagnostic(span=$value, message="null outside the boundary: internal code spells absence as undefined; an adapter maps null to it", severity="error")
}
