{
  "overrides": [
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "domains": {
          "test": "all",
        },
      },
    },
  ],
  "plugins": [
    {
      "path": "./.droneey/constitution/presets/typescript/biome/plugins/test-never-skipped-or-empty.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/plugins/module-never-mocked-in-a-spec.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/plugins/strict-matcher-only.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/plugins/failed-test-never-retried.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/plugins/spec-never-sleeps.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
  ],
}
