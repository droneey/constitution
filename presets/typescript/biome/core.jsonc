{
  "linter": {
    "rules": {
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noAlert": "error",
        "noConsole": "error",
        "noSkippedTests": "error",
        "noFocusedTests": "error",
        "noDebugger": "error",
        "noDeprecatedImports": "error",
      },
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "filenameCases": [
              "kebab-case",
            ],
          },
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
          },
        },
        "useErrorCause": "error",
        "useThrowOnlyError": "error",
        "noNestedTernary": "error",
        "noMagicNumbers": "error",
      },
      "correctness": {
        "noUnreachable": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15,
          },
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 100,
          },
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3,
          },
        },
      },
      "security": {
        "noSecrets": {
          "level": "error",
          "options": {
            "entropyThreshold": 60,
          },
        },
      },
      "nursery": {
        "noConditionalExpect": "error",
        "useExpect": "error",
      },
    },
  },
  "plugins": [
    "./.droneey/constitution/presets/typescript/biome/plugins/catch-handles-only-what-it-recognises.grit",
    {
      "path": "./.droneey/constitution/presets/typescript/biome/plugins/case-named-should-when.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/plugins/case-holds-no-logic.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
  ],
  "overrides": [
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/*.config.cjs",
        "**/.*rc.ts",
        "**/.*rc.js",
        "**/.*rc.mjs",
        "**/.*rc.cjs",
      ],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.gen.*",
        "**/*.gen/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off",
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/tests/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off",
            "noMagicNumbers": "off",
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
          },
        },
      },
    },
  ],
}
