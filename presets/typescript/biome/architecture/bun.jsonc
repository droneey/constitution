{
  "linter": {
    "rules": {
      "style": {
        "noProcessEnv": "error",
      },
    },
  },
  "overrides": [
    {
      "includes": [
        "**/root/**",
        "**/main.*",
        "**/entrypoints/*/main.*",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "tests/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off",
          },
        },
      },
    },
  ],
}
