{
  "linter": {
    "rules": {
      "style": {
        "noProcessEnv": "error",
      },
    },
  },
  "plugins": [
    {
      "path": "./.droneey/constitution/presets/typescript/biome/architecture/plugins/bun-global-reached-only-from-the-edge.grit",
      "includes": [
        "**/features/*/domain/**",
        "**/features/*/app/**",
        "**/kernel/**",
        "**/contracts/**",
        "**/shared/**",
        "**/composition/**",
        "!**/__tests__/**",
      ],
    },
  ],
  "overrides": [
    {
      "includes": [
        "**/root/**",
        "**/main.*",
        "**/entrypoints/*/main.*",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "tests/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off",
          },
        },
      },
    },
  ],
}
