{
  "plugins": [
    "./.droneey/constitution/presets/typescript/biome/architecture/plugins/keys-only-from-the-key-factory.grit",
    {
      "path": "./.droneey/constitution/presets/typescript/biome/architecture/plugins/query-client-built-by-the-root.grit",
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/src/root/**",
        "!**/main.*",
        "!**/entrypoints/*/main.*",
        "!**/src/router.tsx",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/architecture/plugins/query-function-only-in-cache-utils.grit",
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/cache.utils.ts",
        "!**/src/root/**",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
      ],
    },
  ],
}
