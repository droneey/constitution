{
  "linter": {
    "rules": {
      "style": {
        "noProcessEnv": "error",
      },
    },
  },
  "overrides": [
    {
      "includes": [
        "**/root/**",
        "**/main.*",
        "**/entrypoints/*/main.*",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "tests/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off",
          },
        },
      },
    },
  ],
  "plugins": [
    {
      "path": "./.constitution/presets/typescript/biome/foundation/plugins/undefined-is-the-only-absence.grit",
      "includes": [
        "**",
        "!**/adapters/**",
        "!**/models/**",
        "!**/*.tsx",
      ],
    },
    {
      "path": "./.constitution/presets/typescript/biome/foundation/plugins/enums-for-named-value-groups.grit",
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/adapters/**",
        "!**/models/**",
      ],
    },
    {
      "path": "./.constitution/presets/typescript/biome/architecture/plugins/domain-type-fields-readonly.grit",
      "includes": [
        "**/*.entity.ts",
        "**/*.value-object.ts",
      ],
    },
    {
      "path": "./.constitution/presets/typescript/biome/architecture/plugins/surface-only-re-exports.grit",
      "includes": [
        "**/index.ts",
      ],
    },
  ],
}
