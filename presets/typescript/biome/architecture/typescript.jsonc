{
  "plugins": [
    {
      "path": "./.droneey/constitution/presets/typescript/biome/plugins/undefined-is-the-only-absence.grit",
      "includes": [
        "**",
        "!**/adapters/**",
        "!**/models/**",
        "!**/*.tsx",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/plugins/enums-for-named-value-groups.grit",
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/adapters/**",
        "!**/models/**",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/architecture/plugins/domain-type-fields-readonly.grit",
      "includes": [
        "**/*.entity.ts",
        "**/*.value-object.ts",
      ],
    },
    {
      "path": "./.droneey/constitution/presets/typescript/biome/architecture/plugins/surface-only-re-exports.grit",
      "includes": [
        "**/index.ts",
      ],
    },
  ],
}
