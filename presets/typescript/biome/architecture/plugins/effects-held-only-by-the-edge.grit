language js

or {
  `Date.now()`,
  `new Date()`,
  `Math.random()`,
  `crypto.randomUUID()`,
  `crypto.getRandomValues($_)`,
  `Temporal.Now.$method($...)`
} as $call where {
  register_diagnostic(span=$call, message="An effect outside the edge: the clock, randomness and identifiers reach this code through a port", severity="error")
}
