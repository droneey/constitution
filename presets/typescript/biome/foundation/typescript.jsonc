{
  "assist": {
    "actions": {
      "source": {
        "useSortedInterfaceMembers": {
          "level": "on",
          "options": {},
        },
      },
    },
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noDeprecatedImports": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": false,
          },
        },
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noEvolvingTypes": "error",
        "noDuplicateEnumValues": "error",
      },
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "selector": {
                  "kind": "typeParameter",
                },
                "match": "T([A-Z].*)?",
                "formats": [
                  "PascalCase",
                ],
              },
            ],
          },
        },
        "noNonNullAssertion": "error",
        "useEnumInitializers": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "moment": "Use Temporal: date libraries wrap the Date it replaces",
              "dayjs": "Use Temporal: date libraries wrap the Date it replaces",
              "date-fns": "Use Temporal: date libraries wrap the Date it replaces",
              "luxon": "Use Temporal: date libraries wrap the Date it replaces",
            },
            "patterns": [
              {
                "group": [
                  "moment/**",
                  "dayjs/**",
                  "date-fns/**",
                  "luxon/**",
                ],
                "message": "Use Temporal: date libraries wrap the Date it replaces",
              },
            ],
          },
        },
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType",
          },
        },
        "noParameterProperties": "error",
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": {
            "accessibility": "explicit",
          },
        },
        "noNamespace": "error",
        "useReadonlyClassProperties": "error",
        "useUnifiedTypeSignatures": "error",
        "useExportType": "error",
        "useAsConstAssertion": "error",
        "useConsistentArrayType": "error",
        "useConsistentTypeDefinitions": "error",
        "useConsistentEnumValueType": "error",
        "useConsistentMethodSignatures": "error",
        "useThrowOnlyError": "error",
        "noDefaultExport": "error",
      },
      "complexity": {
        "noUselessUndefined": "error",
      },
      "nursery": {
        "noUnsafeTypeAssertion": "error",
        "useExhaustiveSwitchCases": "error",
        "useNullishCoalescing": "error",
        "useExplicitType": "error",
        "noUnsafePlusOperands": "error",
        "noBaseToString": "error",
        "noMisleadingReturnType": "error",
      },
    },
  },
  "plugins": [
    "./.constitution/presets/typescript/biome/foundation/plugins/type-names-undecorated.grit",
    "./.constitution/presets/typescript/biome/foundation/plugins/no-mutable-export.grit",
    {
      "path": "./.constitution/presets/typescript/biome/foundation/plugins/undefined-is-the-only-absence.grit",
      "includes": [
        "**",
        "!**/*.tsx",
      ],
    },
    {
      "path": "./.constitution/presets/typescript/biome/foundation/plugins/enums-for-named-value-groups.grit",
      "includes": [
        "**/*.ts",
        "**/*.tsx",
      ],
    },
  ],
  "overrides": [
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/*.config.cjs",
        "**/.*rc.ts",
        "**/.*rc.js",
        "**/.*rc.mjs",
        "**/.*rc.cjs",
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.config.ts",
        "**/.*rc.ts",
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useExplicitType": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.d.ts",
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
          },
          "style": {
            "noDefaultExport": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentMemberAccessibility": "off",
          },
          "nursery": {
            "useExplicitType": "off",
          },
        },
      },
    },
  ],
}
