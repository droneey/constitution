language js

or {
  jsx_attribute(name=$name, value=$classes) where { $name <: r"className" },
  or {
    `cva($...)`,
    `cn($...)`,
    `clsx($...)`,
    `twMerge($...)`
  } as $classes where { $classes <: not within jsx_attribute() }
} where {
  $classes <: r"(?s).*\boutline-none\b.*",
  register_diagnostic(span=$classes, message="Show focus with focusable: outline-none removes the outline outright", severity="error")
}
