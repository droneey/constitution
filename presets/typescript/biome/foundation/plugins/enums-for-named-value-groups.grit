language js

or {
  TsIndexedAccessType(object_type=TsParenthesizedType(ty=TsTypeofType()), index_type=$index) as $set where {
    $index <: or {
      TsNumberType(),
      TsTypeOperatorType()
    },
    register_diagnostic(span=$set, message="A closed set of named values is a string enum, not a type taken from an as-const array", severity="error")
  },
  TsUnionType(types=$members) as $union where {
    $members <: every TsStringLiteralType(),
    register_diagnostic(span=$union, message="A closed set of named values is a string enum, not a union of string literals", severity="error")
  }
}
