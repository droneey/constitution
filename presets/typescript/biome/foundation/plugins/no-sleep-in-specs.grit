language js

or {
  `Bun.sleep($...)`,
  `Bun.sleepSync($...)`,
  `new Promise($executor)` where { $executor <: contains `setTimeout($...)` },
  JsImport() as $import where {
    $import <: r"(?s).*setTimeout.*node:timers/promises.*"
  }
} as $sleep where {
  register_diagnostic(span=$sleep, message="Wait for a condition or advance a fake clock, never a fixed delay", severity="error")
}
