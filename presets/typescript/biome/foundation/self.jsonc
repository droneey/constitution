{
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "attributePosition": "multiline",
    },
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "natural",
            "groups": [
              ":URL:",
              ":BLANK_LINE:",
              ":NODE:",
              ":BLANK_LINE:",
              ":BUN:",
              ":BLANK_LINE:",
              [
                "@nest*",
                "nest*",
              ],
              ":BLANK_LINE:",
              [
                "react",
                "react/**",
                "react-*",
              ],
              ":BLANK_LINE:",
              "@tanstack/**",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:",
            ],
          },
        },
      },
    },
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noUnusedExpressions": "error",
        "useAwait": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error",
        "noConstantBinaryExpressions": "error",
        "noMisplacedAssertion": "error",
        "noUnassignedVariables": "error",
        "noVar": "error",
        "noReturnAssign": "error",
        "noProto": "error",
        "noForIn": "error",
        "noNestedPromises": "error",
        "noShadow": "error",
        "noUnnecessaryConditions": "error",
        "useArraySortCompare": "error",
      },
      "style": {
        "noParameterAssign": "error",
        "noNestedTernary": "error",
        "useNumberNamespace": "error",
        "noMagicNumbers": "error",
        "useBlockStatements": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "noNegationElse": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useShorthandAssign": "error",
        "noYodaExpression": "error",
        "useExplicitLengthCheck": "error",
        "useAtIndex": "error",
        "useTrimStartEnd": "error",
        "noSubstr": "error",
        "noCommonJs": "error",
        "noDoneCallback": "error",
        "noExportedImports": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useSingleVarDeclarator": "error",
        "useSymbolDescription": "error",
        "useThrowNewError": "error",
        "useNodeAssertStrict": "error",
        "useExportsLast": "error",
        "useForOf": "error",
        "useGroupedAccessorPairs": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useCollapsedIf": "error",
        "useConsistentArrowReturn": "error",
        "useTemplate": "error",
        "useArrayLiterals": "error",
        "useExponentiationOperator": "error",
        "noShoutyConstants": "error",
        "noUnusedTemplateLiteral": "error",
        "noMultiAssign": "error",
        "noExcessiveClassesPerFile": "error",
        "useGlobalThis": "error",
        "noMultilineString": "error",
        "useSpreadOverApply": "error",
        "useNodejsImportProtocol": "error",
      },
      "complexity": {
        "noUselessConstructor": "error",
        "useFlatMap": "error",
        "noUselessRename": "error",
        "noUselessEmptyExport": "error",
        "noUselessSwitchCase": "error",
        "useLiteralKeys": "off",
        "noUselessTernary": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessLabel": "error",
        "noExtraBooleanCast": "error",
        "noVoid": "error",
        "noUselessStringConcat": "error",
        "noImplicitCoercions": "error",
        "noForEach": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error",
        "noUselessReturn": "error",
        "noRedundantDefaultExport": "error",
        "useArrayFind": "error",
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noUndeclaredDependencies": "error",
        "useJsonImportAttributes": "error",
        "noUnusedInstantiation": "error",
      },
      "performance": {
        "noDelete": "error",
        "noAccumulatingSpread": "error",
        "noAwaitInLoops": "error",
        "noDynamicNamespaceImportAccess": "error",
      },
      "nursery": {
        "useArraySome": "error",
        "useAwaitThenable": "error",
        "useStringStartsEndsWith": "error",
        "useRegexpTest": "error",
        "noUselessTypeConversion": "error",
        "noEmptyObjectKeys": "error",
        "noImpliedEval": "error",
        "noExtendNative": "error",
        "noLoopFunc": "error",
        "noNegationInEqualityCheck": "error",
        "noThisOutsideOfClass": "error",
        "useIncludes": "error",
        "useModernMathApis": "error",
        "useFlatMathMinMax": "error",
      },
    },
  },
  "overrides": [
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off",
          },
          "complexity": {
            "noStaticOnlyClass": "off",
          },
          "nursery": {
            "noIdenticalTestTitle": "error",
          },
        },
      },
    },
  ],
  "plugins": [
    "./.droneey/constitution/presets/typescript/biome/foundation/plugins/biome-refuses-empty-verbs.grit",
    {
      "path": "./.droneey/constitution/presets/typescript/biome/foundation/plugins/biome-refuses-empty-names.grit",
      "includes": [
        "**",
      ],
    },
  ],
}
